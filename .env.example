# Environment Variables Template for Netlify
# Copy this file to .env.local for local development
# Add these variables to Netlify Dashboard → Site settings → Environment variables

# API Configuration
VITE_API_URL=https://your-backend-api-url.com

# App Configuration
VITE_APP_NAME=Kibegi
VITE_APP_VERSION=1.0.0

# Optional: Add any other environment variables your app needs
# Note: All variables must be prefixed with VITE_ to be accessible in React

# Example additional variables:
# VITE_ENABLE_ANALYTICS=true
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_GOOGLE_ANALYTICS_ID=your-ga-id
