# Frontend Application Template Environment Configuration
# Copy this file to .env or .env.local to customize your environment

# Application Metadata
VITE_APP_TITLE=Frontend Template
VITE_APP_ENV=development

# Backend API Configuration
# Base URL for API client requests
VITE_API_BASE_URL=http://localhost:8000/api

# Feature Flags
VITE_ENABLE_MOCK_AUTH=true
